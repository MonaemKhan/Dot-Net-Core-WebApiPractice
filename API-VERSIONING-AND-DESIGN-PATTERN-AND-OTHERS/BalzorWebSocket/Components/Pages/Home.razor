@inject HttpClient _httpClient
@page "/"

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>
<h3>Device Id := @deviceId</h3>
<input type="text" @bind-value="@name" />
<button @onclick="btnClick">send Request</button>

Welcome to your new app.

@code{
    private string deviceId;
    private string name;
    protected override async Task OnInitializedAsync()
    {
        // var responce = await _httpClient.GetAsync("WeatherForecast/set-device-id");
        // if (responce.IsSuccessStatusCode)
        // {
        //     deviceId = await responce.Content.ReadAsStringAsync();
        // }
    }
    private async Task btnClick()
    {
        var responce = await _httpClient.GetAsync("WeatherForecast/set-device-id?Name="+name);
        if (responce.IsSuccessStatusCode)
        {
            deviceId = await responce.Content.ReadAsStringAsync();
        }
        responce = await _httpClient.GetAsync("WeatherForecast/Same-task");
        Console.WriteLine("button clicked");
    }
}